# Copy this file to .env and fill it in. Each machine has its own .env with only what it needs.
# Never commit .env or key files.

# --- Server (the brain): voice pipeline and agent ---
ANTHROPIC_API_KEY=
GOOGLE_CLOUD_PROJECT=
# Service-account key file (JSON) for Speech-to-Text. API keys don't work with Chirp 3.
GOOGLE_APPLICATION_CREDENTIALS=google-key.json
# Optional: Gemini's free tier answers requests with no personal data (aistudio.google.com/apikey).
# Without it, Claude answers everything.
# GEMINI_API_KEY=
# Optional: web search with Tavily's free plan (tavily.com). Without it, there is no web search.
# TAVILY_API_KEY=
# Where the agent listens: the server's Tailscale address (tailscale ip -4), never a public one.
NATRO_LISTEN=127.0.0.1:8700
# A long random secret every device must send. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
NATRO_DEVICE_TOKEN=
# USD per month for Claude and Google together; Natro warns at 80% and asks before using Claude at 100%.
NATRO_MONTHLY_BUDGET=15
NATRO_TIMEZONE=Asia/Tbilisi

# --- PC (device app) ---
# The agent's address: ws://<server's Tailscale address>:8700
NATRO_SERVER=ws://127.0.0.1:8700
# NATRO_DEVICE_TOKEN= (the same secret as on the server)
# Kokoro speaker for spoken replies (0 = "af", American female).
# NATRO_VOICE=0
# The tray app's talk key (pynput's format).
# NATRO_HOTKEY=<ctrl>+<alt>+<space>
# Only for the one-time Spotify sign-in (python -m natro_agent.spotify_signin): the Spotify developer
# app's Client ID. The server doesn't need it: it's saved in tokens/spotify.json.
# SPOTIFY_CLIENT_ID=
